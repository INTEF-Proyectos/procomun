{
	"name": "procomun",
	"version": "1.0.0",
	"module": "apps/api/src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --filter '@procomun/*' dev",
		"dev:api": "bun run --filter '@procomun/api' dev",
		"dev:frontend": "bun run --filter '@procomun/frontend' dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"design:lint": "bun run scripts/check-design-md.ts",
		"check-tracking": "bun run scripts/check-tracking.ts",
		"new-status-key": "bun run scripts/new-status-key.ts",
		"paraglide:compile": "bun apps/frontend/node_modules/@inlang/paraglide-js/bin/run.js compile --project apps/frontend/project.inlang --outdir apps/frontend/src/paraglide --strategy url baseLocale --silent",
		"check-types": "bun run paraglide:compile && bun run scripts/check-types.ts",
		"test": "bun run check-test-files && bun run test:standard && bun run check-coverage",
		"check-test-files": "bun run scripts/check-test-files.ts",
		"test:standard": "bun run test:unit && bun run test:integration",
		"test:unit": "bun run scripts/run-bun-suite.ts unit",
		"test:integration": "bun run scripts/run-bun-suite.ts integration",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed --project=chromium",
		"test:e2e:report": "playwright show-report",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:e2e:webkit": "playwright test --project=webkit",
		"test:e2e:all": "playwright test",
		"test:e2e:preflight": "bun run scripts/check-e2e-env.ts",
		"check-coverage": "bun run scripts/check-coverage.ts"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@types/bun": "1.3.14",
		"@playwright/test": "1.62.1",
		"@biomejs/biome": "2.5.7",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.4",
		"drizzle-orm": "^0.45.2"
	}
}
