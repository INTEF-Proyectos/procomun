# Base de datos (vacío = PGlite local para desarrollo, sin instalar PostgreSQL)
# DATABASE_URL=postgres://user:pass@localhost:5432/procomun

# URL pública de la aplicación en desarrollo local.
# El navegador entra por el frontend (5173) y Vite hace proxy de /api/* al backend (3000).
# BETTER_AUTH_URL debe apuntar a esta URL pública, no al puerto interno de la API.
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Preview HTTP del editor.
# En topología separada, usa el origen público que sirve el editor y la API.
# Si se omite, se deriva de BETTER_AUTH_URL y después de FRONTEND_URL.
# PREVIEW_MANAGEMENT_ORIGIN=https://api.procomun.example
# Techo de cuerpo aplicado por Bun antes de que Hono materialice multipart (256 MiB).
API_MAX_REQUEST_BODY_BYTES=268435456
# PREVIEW_SESSION_TTL_MINUTES=30
# PREVIEW_MAX_SESSIONS_PER_USER=4
# PREVIEW_MAX_FILES_PER_SESSION=5000
# PREVIEW_MAX_BYTES_PER_SESSION_MB=200
# PREVIEW_MAX_ASSET_BYTES_MB=128
# PREVIEW_GLOBAL_MAX_BYTES_MB=2048
# PREVIEW_MULTI_REPLICA=0
# PREVIEW_STICKY_ROUTING_CONFIRMED=0

# OpenID Connect (SSO) opcional — Duende demo server
# Si OIDC_ENABLED no está en true, el login institucional no se activa.
# Usuario de prueba: bob / bob (o alice / alice)
OIDC_ENABLED=true
OIDC_ISSUER=https://demo.duendesoftware.com
OIDC_CLIENT_ID=interactive.confidential
OIDC_CLIENT_SECRET=secret
OIDC_SCOPE=openid email profile

# Verificación de correo en el registro (DEF-003 / ADR-0031).
# El flag controla el bloqueo del login, el envío automático al alta (sendOnSignUp)
# y el reenvío cuando alguien sin verificar intenta entrar (sendOnSignIn).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Caducidad del enlace en segundos; entero entre 1 y 2592000 (30 días).
# Vacío = valor por defecto (3600); un valor no entero impide el arranque.
EMAIL_VERIFICATION_EXPIRES_IN=3600
# SMTP es obligatorio fuera de development/test/CI cuando se activa la verificación.
# Sin SMTP_HOST, en development/test/CI se usa LogEmailTransport (nunca en production/staging).
# SMTP_HOST=smtp.tu-proveedor.com
# Vacío = valor por defecto (587); un valor fuera de 1-65535 impide el arranque.
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# MAIL_FROM es obligatorio con SMTP fuera de development/test/CI.
# MAIL_FROM=Procomún <no-reply@example.com>

# Uploads resumables
# UPLOAD_STORAGE_DIR=./local-data/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10737418240
UPLOAD_MAX_FILES_PER_BATCH=20
UPLOAD_MAX_CONCURRENT_PER_USER=3
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_TTL_MS=86400000
# Valores CSV. Ajusta a tu operación real.
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.zip,.scorm,.mp4,.mp3,.wav,.png,.jpg,.jpeg,.gif,.webp,.csv,.json
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip,application/x-zip-compressed,application/json,text/csv,video/mp4,audio/mpeg,audio/wav,image/png,image/jpeg,image/gif,image/webp
